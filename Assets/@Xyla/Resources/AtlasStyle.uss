#atlas { color: rgb(30,49,58); font-size: 16px; }
Label { white-space: normal; flex-shrink: 0; }
Button { min-height: 44px; border-width: 0; border-radius: 10px; background-color: rgb(231,238,240); color: rgb(35,57,66); padding: 8px 13px; margin: 2px; font-size: 16px; flex-shrink: 0; }
Button:hover { background-color: rgb(207,226,225); }
Button:active, Button.active, Button.primary { background-color: rgb(31,91,91); color: white; }
Button:disabled { opacity: .38; }
.row { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.panel { background-color: rgb(255,255,255); border-radius: 16px; padding: 14px; }
.header { position: absolute; left: 16px; right: 12px; top: 8px; height: 48px; flex-direction: row; justify-content: space-between; align-items: center; }
.branding { flex-direction: row; align-items: center; }
.brand { font-size: 23px; -unity-font-style: bold; }
.eyebrow { font-size: 11px; letter-spacing: 1px; color: rgb(66,103,106); margin-left: 14px; }
.muted { font-size: 13px; color: rgb(77,95,104); margin-top: 6px; margin-bottom: 6px; }
.section-title { font-size: 19px; -unity-font-style: bold; }
.drawer { position: absolute; top: 64px; right: 12px; bottom: 12px; }
.system-list { flex-grow: 1; margin-top: 7px; margin-bottom: 5px; }
.system-row { flex-direction: row; align-items: center; min-height: 46px; flex-shrink: 0; }
.dot { width: 7px; height: 7px; border-radius: 4px; margin-right: 7px; }
.system-name { background-color: transparent; flex-grow: 1; font-size: 16px; -unity-text-align: middle-left; padding-left: 0; margin-left: 0; }
Toggle { width: 46px; min-height: 44px; align-items: center; justify-content: center; margin: 0; }
Toggle .unity-toggle__checkmark { width: 32px; height: 20px; border-width: 0; border-radius: 10px; background-color: rgb(200,211,215); background-image: none; }
Toggle:checked .unity-toggle__checkmark { background-color: rgb(31,115,110); }
.presets Button { padding-left: 6px; padding-right: 6px; font-size: 14px; flex-grow: 1; }
.camera-bar { position: absolute; top: 64px; left: 12px; width: 66px; bottom: 12px; justify-content: flex-start; }
.camera-bar Button { font-size: 14px; padding: 6px 3px; margin-bottom: 3px; min-height: 44px; }
.caption { position: absolute; bottom: 89px; left: 90px; right: 12px; -unity-text-align: middle-center; font-size: 13px; color: rgb(63,91,99); }
.bottom { position: absolute; bottom: 12px; left: 90px; right: 12px; height: 70px; flex-direction: row; align-items: center; padding: 8px 12px; }
.slider-box { flex-grow: 1; margin-right: 15px; }
Slider { height: 30px; margin-top: 3px; margin-left: 6px; margin-right: 6px; }
Slider .unity-base-slider__tracker { height: 4px; border-width: 0; background-color: rgb(206,220,222); border-radius: 3px; }
Slider .unity-base-slider__dragger { width: 22px; height: 22px; border-width: 2px; border-color: white; border-radius: 11px; background-color: rgb(31,91,91); margin-top: -9px; }
.badge { background-color: rgb(233,241,240); padding: 3px 9px; border-radius: 5px; font-size: 14px; color: rgb(31,91,91); }
.search-input { margin-top: 9px; min-height: 44px; font-size: 18px; flex-shrink: 0; }
.search-input .unity-text-field__input { border-width: 1px; border-color: rgb(150,178,179); border-radius: 8px; padding: 8px; background-color: rgb(245,249,249); color: rgb(30,49,58); }
.results { flex-grow: 1; margin-top: 7px; }
.search-result { min-height: 58px; -unity-text-align: middle-left; font-size: 16px; white-space: normal; }
.detail-title { font-size: 24px; -unity-font-style: bold; margin-top: 7px; margin-bottom: 9px; }
.detail-scroll { flex-grow: 1; margin-bottom: 9px; }
.description { font-size: 16px; white-space: normal; margin-bottom: 12px; }
.about ScrollView { flex-grow: 1; }
.loading { position: absolute; left: 25%; right: 25%; top: 42%; align-items: center; padding: 24px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller--vertical { width: 9px; min-width: 9px; }
